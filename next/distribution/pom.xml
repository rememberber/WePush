<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.fangxuele.wepush.next</groupId>
        <artifactId>wepush-next-parent</artifactId>
        <version>0.1.0-alpha.4</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>wepush-next-distribution</artifactId>
    <packaging>pom</packaging>
    <name>WePush Next :: Distribution</name>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>service-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>agent-app</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>sdk-java</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>embedded-java</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>provider-http</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.8.0</version>
                <configuration>
                    <finalName>wepush-next-${project.version}</finalName>
                    <appendAssemblyId>false</appendAssemblyId>
                    <descriptors>
                        <descriptor>src/assembly/distribution.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>release-bundles</id>
                        <phase>package</phase>
                        <goals><goal>single</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.2.0</version>
                <executions>
                    <execution>
                        <id>validate-web-distribution</id>
                        <phase>prepare-package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration><target>
                            <available file="${project.basedir}/../ui/apps/web/dist/index.html"
                                       property="wepush.web.distribution.present"/>
                            <fail unless="wepush.web.distribution.present"
                                  message="WebUI dist is missing; run pnpm --filter @wepush-next/web build first"/>
                        </target></configuration>
                    </execution>
                    <execution>
                        <id>release-checksums</id>
                        <phase>package</phase>
                        <goals><goal>run</goal></goals>
                        <configuration><target>
                            <checksum file="${project.build.directory}/wepush-next-${project.version}.tar.gz"
                                      algorithm="SHA-256" fileext=".sha256" format="MD5SUM"
                                      forceOverwrite="yes"/>
                            <checksum file="${project.build.directory}/wepush-next-${project.version}.zip"
                                      algorithm="SHA-256" fileext=".sha256" format="MD5SUM"
                                      forceOverwrite="yes"/>
                        </target></configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
