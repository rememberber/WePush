<?xml version="1.0" encoding="UTF-8"?>
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
    <id>distribution</id>
    <formats><format>tar.gz</format><format>zip</format></formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>wepush-next-${project.version}</baseDirectory>
    <files>
        <file>
            <source>../../LICENSE.txt</source>
            <outputDirectory>/</outputDirectory>
            <destName>LICENSE.txt</destName>
        </file>
        <file>
            <source>../README.md</source>
            <outputDirectory>/</outputDirectory>
            <destName>README.md</destName>
        </file>
        <file>
            <source>../PREVIEW-NOTICE.md</source>
            <outputDirectory>/</outputDirectory>
            <destName>PREVIEW-NOTICE.md</destName>
        </file>
        <file>
            <source>../CHANGELOG.md</source>
            <outputDirectory>/</outputDirectory>
            <destName>CHANGELOG.md</destName>
        </file>
        <file>
            <source>../SECURITY.md</source>
            <outputDirectory>/</outputDirectory>
            <destName>SECURITY.md</destName>
        </file>
        <file>
            <source>../THIRD-PARTY-NOTICES.md</source>
            <outputDirectory>/</outputDirectory>
            <destName>THIRD-PARTY-NOTICES.md</destName>
        </file>
        <file>
            <source>../docs/releases/0.1.0-alpha.2.md</source>
            <outputDirectory>/</outputDirectory>
            <destName>RELEASE-NOTES.md</destName>
        </file>
        <file>
            <source>../service/service-api/src/main/resources/openapi/openapi.yaml</source>
            <outputDirectory>api</outputDirectory>
            <destName>openapi.yaml</destName>
        </file>
        <file>
            <source>../sdk/README.md</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>README.md</destName>
        </file>
        <file>
            <source>../sdk/embedded-java/README.md</source>
            <outputDirectory>sdk/embedded-java</outputDirectory>
            <destName>README.md</destName>
        </file>
        <file>
            <source>../pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>wepush-next-parent-${project.version}.pom</destName>
        </file>
        <file>
            <source>../service/service-api/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>service-api-${project.version}.pom</destName>
        </file>
        <file>
            <source>../service/service-api/target/service-api-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>service-api-${project.version}.jar</destName>
        </file>
        <file>
            <source>../sdk/sdk-java/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>sdk-java-${project.version}.pom</destName>
        </file>
        <file>
            <source>../sdk/sdk-java/target/sdk-java-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>sdk-java-${project.version}.jar</destName>
        </file>
        <file>
            <source>../core/core-api/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>core-api-${project.version}.pom</destName>
        </file>
        <file>
            <source>../core/core-api/target/core-api-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>core-api-${project.version}.jar</destName>
        </file>
        <file>
            <source>../core/provider-spi/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>provider-spi-${project.version}.pom</destName>
        </file>
        <file>
            <source>../core/provider-spi/target/provider-spi-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>provider-spi-${project.version}.jar</destName>
        </file>
        <file>
            <source>../core/engine/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>engine-${project.version}.pom</destName>
        </file>
        <file>
            <source>../core/engine/target/engine-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>engine-${project.version}.jar</destName>
        </file>
        <file>
            <source>../providers/provider-http/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>provider-http-${project.version}.pom</destName>
        </file>
        <file>
            <source>../providers/provider-http/target/provider-http-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>provider-http-${project.version}.jar</destName>
        </file>
        <file>
            <source>../sdk/embedded-java/pom.xml</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>embedded-java-${project.version}.pom</destName>
        </file>
        <file>
            <source>../sdk/embedded-java/target/embedded-java-${project.version}.jar</source>
            <outputDirectory>sdk</outputDirectory>
            <destName>embedded-java-${project.version}.jar</destName>
        </file>
        <file>
            <source>../service/service-app/target/wepush-next-service.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>wepush-next-service.jar</destName>
        </file>
        <file>
            <source>../agent/agent-app/target/wepush-next-agent.jar</source>
            <outputDirectory>lib</outputDirectory>
            <destName>wepush-next-agent.jar</destName>
        </file>
    </files>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/../docs</directory>
            <outputDirectory>docs</outputDirectory>
            <includes>
                <include>**/*.md</include>
            </includes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/main/distribution</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>bin/**</include>
                <include>install/**/*.sh</include>
                <include>install/**/*.ps1</include>
                <include>plugins/**/*.sh</include>
                <include>plugins/**/*.ps1</include>
            </includes>
            <fileMode>0755</fileMode>
        </fileSet>
        <fileSet>
            <directory>src/main/distribution</directory>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <exclude>bin/**</exclude>
                <exclude>install/**/*.sh</exclude>
                <exclude>install/**/*.ps1</exclude>
                <exclude>plugins/**/*.sh</exclude>
                <exclude>plugins/**/*.ps1</exclude>
            </excludes>
            <fileMode>0644</fileMode>
        </fileSet>
        <fileSet>
            <directory>${project.basedir}/../ui/apps/web/dist</directory>
            <outputDirectory>web</outputDirectory>
            <includes><include>**/*</include></includes>
            <fileMode>0644</fileMode>
        </fileSet>
    </fileSets>
</assembly>
