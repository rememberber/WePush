# Standalone defaults. Server mode must override PostgreSQL, S3, API security and Agent TLS.
WEPUSH_MODE=standalone
WEPUSH_BIND_ADDRESS=127.0.0.1
WEPUSH_PORT=18990
WEPUSH_DATABASE_KIND=sqlite
WEPUSH_DATABASE_PATH=/var/lib/wepush-next/service/wepush-next.db
WEPUSH_ARTIFACT_KIND=local
WEPUSH_ARTIFACT_ROOT=/var/lib/wepush-next/service/artifacts
WEPUSH_MASTER_KEY_PATH=/var/lib/wepush-next/service/secrets/master-key.json
WEPUSH_AGENT_CA_KEY_PATH=/var/lib/wepush-next/service/agent-ca/ca-key.pem
WEPUSH_AGENT_CA_CERTIFICATE_PATH=/var/lib/wepush-next/service/agent-ca/ca-certificate.pem
WEPUSH_AGENT_ARTIFACT_MAXIMUM_BYTES=5497558138880
WEPUSH_AGENT_ARTIFACT_MULTIPART_THRESHOLD_BYTES=1073741824
WEPUSH_AUTH_CIRCUIT_THRESHOLD=3
WEPUSH_AUTH_CIRCUIT_WINDOW=PT15M
WEPUSH_AUTH_CIRCUIT_OPEN_DURATION=PT15M
# Manual version checks only; no background checker exists.
WEPUSH_VERSION_CHECK_RELEASES_URI=https://api.github.com/repos/rememberber/WePush/releases?per_page=50
WEPUSH_JAVA_OPTS=-XX:MaxRAMPercentage=75 -Djava.io.tmpdir=/var/lib/wepush-next/service/tmp
