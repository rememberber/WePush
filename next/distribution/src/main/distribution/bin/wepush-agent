#!/bin/sh
set -eu
WEPUSH_RELEASE_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
WEPUSH_AGENT_ENV=${WEPUSH_AGENT_ENV:-/etc/wepush-next/agent.env}
if [ -r "$WEPUSH_AGENT_ENV" ]; then
  set -a
  . "$WEPUSH_AGENT_ENV"
  set +a
fi
if [ -n "${WEPUSH_JAVA:-}" ]; then WEPUSH_JAVA_COMMAND=$WEPUSH_JAVA
elif [ -x "$WEPUSH_RELEASE_ROOT/runtime/bin/java" ]; then WEPUSH_JAVA_COMMAND="$WEPUSH_RELEASE_ROOT/runtime/bin/java"
else WEPUSH_JAVA_COMMAND=java; fi
exec "$WEPUSH_JAVA_COMMAND" --enable-native-access=ALL-UNNAMED ${WEPUSH_JAVA_OPTS:-} -jar "$WEPUSH_RELEASE_ROOT/lib/wepush-next-agent.jar" "$@"
