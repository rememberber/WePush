[Unit]
Description=WePush Next Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wepush
Group=wepush
Environment=WEPUSH_SERVICE_ENV=/etc/wepush-next/service.env
ExecStart=/opt/wepush-next/current/bin/wepush-service
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/wepush-next/service /var/log/wepush-next

[Install]
WantedBy=multi-user.target
