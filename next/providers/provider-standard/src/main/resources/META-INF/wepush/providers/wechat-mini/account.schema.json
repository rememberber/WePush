{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://wepush.dev/schemas/providers/wechat-mini/account/1",
  "title":"WeChat Mini Program Account",
  "type":"object","additionalProperties":false,"required":["appId","appSecret"],
  "properties":{
    "appId":{"type":"string","minLength":1},
    "appSecret":{"$ref":"#/$defs/secretRef"},
    "connectTimeout":{"type":"string","default":"PT10S"}
  },
  "$defs":{"secretRef":{"type":"object","additionalProperties":false,
    "required":["namespace","name","version"],"properties":{
      "namespace":{"type":"string","default":"wechat"},
      "name":{"type":"string","x-wepush-secret":true},
      "version":{"type":"string","default":"v1"}
  }}}
}
