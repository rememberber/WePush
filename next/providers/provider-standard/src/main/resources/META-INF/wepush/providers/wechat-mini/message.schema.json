{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://wepush.dev/schemas/providers/wechat-mini/message/1",
  "title":"WeChat Mini Program Message",
  "type":"object","additionalProperties":false,"required":["type","payloadJsonTemplate"],
