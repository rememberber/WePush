{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wepush.dev/schemas/providers/ksyun-sms/message/1",
  "title": "Ksyun SMS Message",
  "type": "object",
  "additionalProperties": false,
  "required": ["signName", "templateId"],
  "properties": {
    "signName": {"type": "string", "minLength": 1, "default":"YOUR_SIGN_NAME"},
    "templateId": {"type": "string", "minLength": 1, "default":"SMS_TEMPLATE_ID"},
    "templateParamJsonTemplate": {"type": "string", "default": "{}", "x-wepush-code-language": "json", "x-wepush-variable": true},
    "extId": {"type": "string"}
  }
}
